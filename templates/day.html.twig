{% extends 'base.html.twig' %}

{% block title %}Day {{ game_day.day.title }}{% endblock %}

{% block body %}
    <h2 class="day-header">Day {{ game_day.day.title }}</h2>
    <h3 class="day-header">--- {{ game_day.title}} ---</h3>

    <div class="day-main">
        <div class="day-main-left">
            <fieldset>
                {{ form(form) }}
            </fieldset>

            <fieldset class="result-block">
                <h3 class="mb-4 text-3xl">Result:</h3>
                <div id="result">{{ result }}</div>
            </fieldset>
        </div>
        <div class="day-main-right">
            <twig:Examples partNr="1"/>
        </div>
    </div>
{% endblock %}
