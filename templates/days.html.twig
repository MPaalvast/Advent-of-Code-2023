{% extends 'base.html.twig' %}

{% block title %}Selected Year: {{ year }}{% endblock %}

{% block body %}
    <h2 id="selected-year">Year: {{ year }}</h2>
    <div class="day-container" id="day-container">
        {% for gameDay in yearGameDays %}
            {% if gameDay.active %}
                <twig:DayBlock
                    :gameDay="gameDay"
                    :selectable="true"
                />
            {% else %}
                <twig:DayBlock
                    :gameDay="gameDay"
                    :selectable="false"
                />
            {% endif %}
        {% endfor %}
    </div>
{% endblock %}